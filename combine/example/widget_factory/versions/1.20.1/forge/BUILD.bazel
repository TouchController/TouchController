load("@rules_java//java:java_binary.bzl", "java_binary")
load("//combine:libraries.bzl", "combine_unified_deps", "combine_unified_forge")
load("//rule:merge_library.bzl", "kt_merge_library", "merge_library_jar")
load("//rule:unified_jar.bzl", "unified_jar")

kt_merge_library(
    name = "widget_factory_unmerged",
    srcs = glob(["*.kt"]),
    javac_opts = "//combine:javac_opts_jvm_17",
    kotlinc_opts = "//combine:kotlinc_opts_jvm_17",
    resource_strip_prefix = "combine/example/widget_factory/versions/1.20.1/forge/resources",
    resources = glob(["resources/**"]),
    deps = [
        "//game/1.20.1:game_client_forge_named",
    ] + [
        "//:compose",
        "//combine/backend/minecraft/game/1.20.1",
        "//combine/core/data",
        "//combine/core/layout",
        "//combine/core/modifier",
        "//combine/core/modifier/placement",
        "//combine/core/screen",
        "//combine/core/widget/layout",
        "//combine/data",
        "//combine/example/widget_factory/common",
        "//combine/theme/base",
        "//combine/theme/vanilla",
        "//combine/widget",
        "@forge_1_20_1//:net_minecraftforge_eventbus",
        "@forge_1_20_1//:net_minecraftforge_fmlcore",
        "@forge_1_20_1//:net_minecraftforge_fmlloader",
        "@forge_1_20_1//:net_minecraftforge_forgespi",
        "@forge_1_20_1//:net_minecraftforge_javafmllanguage",
        "@forge_1_20_1//:net_minecraftforge_mergetool",
    ],
)

merge_library_jar(
    name = "widget_factory_unmapped",
    deps = [
        ":widget_factory_unmerged",
        "//combine/example/widget_factory/common",
    ],
)

alias(
    name = "1.20.1",
    actual = ":widget_factory_unmapped",
    visibility = ["//visibility:public"],
)

unified_jar(
    name = "widget_factory_unmapped_merged",
    forge_rules = combine_unified_forge | {
        "combine-common": "",
        "combine-theme-blackstone": "",
        "combine-theme-blackstone-atlas": "minecraft: +[1.20.1]",
        "combine-theme-oreui": "",
        "combine-theme-oreui-atlas": "minecraft: +[1.20.1]",
        "combine-forge-1-20-1": "minecraft: +[1.20.1]",
        "combine-widget-factory": "",
    },
    deps = combine_unified_deps | {
        "combine-common": "//combine/backend/minecraft:minecraft_common_standalone",
        "combine-theme-blackstone": "//combine/theme/blackstone:blackstone_common",
        "combine-theme-blackstone-atlas": "//combine/theme/blackstone:blackstone_atlas",
        "combine-theme-oreui": "//combine/theme/oreui:oreui_common",
        "combine-theme-oreui-atlas": "//combine/theme/oreui:oreui_atlas",
        "combine-forge-1-20-1": "//combine/backend/minecraft/forge/1.20.1",
        "combine-widget-factory": ":widget_factory_unmapped",
    },
)

java_binary(
    name = "dev_client",
    srcs = [],
    data = [
        "//game/1.20.1:game_client_assets",
        "//game/1.20.1:game_client_assets_version",
        "//game/1.20.1:game_client_forge_named",
        "//game/1.20.1:kotlinforforge",
    ] + [
        ":widget_factory_unmapped_merged",
        "@forge_1_20_1//:forge_modules",
        "@forge_1_20_1//:ignore_list_client",
        "@forge_1_20_1//:resources_jar",
    ],
    env = {
        "LANG": "en_US.UTF8",
    },
    jvm_flags = [
        "--add-exports=java.base/sun.security.util=cpw.mods.securejarhandler",
        "--add-exports=jdk.naming.dns/com.sun.jndi.dns=java.naming",
        "--add-opens=java.base/java.util.jar=cpw.mods.securejarhandler",
        "--add-opens=java.base/java.lang.invoke=cpw.mods.securejarhandler",
        "--add-modules=ALL-MODULE-PATH",
        "-Ddev.launch.forgeVersion=47.4.10",
        "-Ddev.launch.mcpVersion=20230612.114412",
        "-Ddev.launch.version=1.20.1",
        "-Ddev.launch.legacyFml=true",
        "-Ddev.launch.type=client",
        "-Ddev.launch.ignoreList=$(rlocationpath @forge_1_20_1//:ignore_list_client)",
        "-Ddev.launch.assetsVersion=$(rlocationpath //game/1.20.1:game_client_assets_version)",
        "-Ddev.launch.classPath=$(rlocationpath :widget_factory_unmapped_merged)",
        "-Ddev.launch.classPath=$(rlocationpath //game/1.20.1:kotlinforforge)",
        "-Ddev.launch.copyFile=$(rlocationpath @forge_1_20_1//:resources_jar):client-extra.jar",
        "-classpath",
        "./client-extra.jar",
        "-Ddev.launch.copyFile=$(rlocationpath //game/1.20.1:game_client_forge_named):forge-1.20.1-47.4.10.jar",
        "-classpath",
        "./forge-1.20.1-47.4.10.jar",
        "-Xmx4G",
        "START_MODULEPATH",
        "$(rlocationpaths @forge_1_20_1//:forge_modules)",
        "END_MODULEPATH",
        "--",
        "--launchTarget=forgeclientuserdev",
    ],
    launcher = "//rule/dev_launch_wrapper:launcher",
    main_class = "cpw.mods.bootstraplauncher.BootstrapLauncher",
    runtime_deps = [
        "//game/1.20.1:game_client_libraries",
    ] + [
        "@forge_1_20_1//:forge_deps",
    ],
)
