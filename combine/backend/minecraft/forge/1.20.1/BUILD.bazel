load("//combine:properties.bzl", "combine_description", "combine_home_page", "combine_issue_tracker", "combine_license", "combine_sources_page", "combine_version")
load("//rule:class_version_test.bzl", "class_version_test")
load("//rule:merge_library.bzl", "merge_library_jar")
load("//rule:remap_jar.bzl", "remap_jar")
load("//rule/forge:mod_toml_jar.bzl", "forge_mod_toml_jar")

forge_mod_toml_jar(
    name = "forge_mods_toml",
    src = "mods.toml",
    pack_mcmeta = "pack.mcmeta",
    substitutions = {
        "${version}": combine_version,
        "${license}": combine_license,
        "${description}": combine_description,
        "${home_page}": combine_home_page,
        "${sources_page}": combine_sources_page,
        "${issue_tracker}": combine_issue_tracker,
    },
)

merge_library_jar(
    name = "forge_unmapped",
    aspect_impl_package_suffix = "forge.v1_20_1",
    aspects = ["//combine/backend/minecraft:minecraft_unmerged"],
    resources = {
        "//combine/resources:icon": ".",
    },
    visibility = ["//visibility:public"],
    deps = [
        ":forge_mods_toml",
        "//combine/backend/minecraft/versions/1.20.1",
    ],
)

class_version_test(
    name = "forge_class_version",
    class_major = 61,
    jars = [":forge_unmapped"],
    tags = ["class_version"],
)

remap_jar(
    name = "forge",
    classpath = ["//game/1.20.1:game_client_forge_named"],
    from_namespace = "named",
    inputs = [":forge_unmapped"],
    mapping = "//game/1.20.1:game_merged_mapping",
    mixin = True,
    to_namespace = "srg",
)

alias(
    name = "1.20.1",
    actual = ":forge",
    visibility = ["//visibility:public"],
)
