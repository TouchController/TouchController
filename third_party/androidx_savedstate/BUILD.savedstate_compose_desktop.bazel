load("@rules_java//java:defs.bzl", "java_import")
load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_common_library", "kt_jvm_library")

kt_kotlinc_options(
    name = "kotlinc_opts_jvm_8",
    jvm_target = "1.8",
    x_jdk_release = "1.8",
    x_lambdas = "indy",
)

kt_common_library(
    name = "common",
    srcs = glob(["commonMain/**/*.kt"]),
    fragment_name = "commonMain",
)

kt_jvm_library(
    name = "savedstate_compose_desktop_lib",
    srcs = glob(["nonAndroidMain/**/*.kt"]),
    kotlinc_opts = ":kotlinc_opts_jvm_8",
    deps = [
        ":common",
        "@maven//:androidx_compose_runtime_runtime_desktop",
        "@maven//:androidx_savedstate_savedstate_desktop",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
    ],
)

java_import(
    name = "savedstate_compose_desktop",
    jars = ["savedstate_compose_desktop_lib.jar"],
    srcjar = "savedstate_compose_desktop_lib-sources.jar",
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:androidx_annotation_annotation_jvm",
        "@maven//:androidx_arch_core_core_common",
        "@maven//:androidx_lifecycle_lifecycle_common_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)
