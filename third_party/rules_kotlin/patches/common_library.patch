+package io.bazel.kotlin.agent;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Rewrites the paths carried by the worker's fragment pass-through flags.
+ *
+ * <p>The Build Tools API turns the compilation unit's sources into compiler free arguments with
+ * {@code File.absolutePath}, while the flags forwarded by this worker keep the execution paths
+ * Bazel passed in. The Kotlin compiler matches {@code -Xfragment-sources} entries against the free
+ * arguments verbatim, so without this rewrite every source is reported as not belonging to any
+ * module. The rewrite uses {@code File.absolutePath} as well, which is what makes the two sides
+ * agree: the agent runs in the worker process, whose working directory is the execution root.
+ *
+ * <p>Only {@code java.base} is used, so the class also works when loaded outside this package's
+ * class loader.
+ */
+public final class PathFixer {
+  /** The flags whose value is {@code <fragment>:<path>} and whose path needs absolutizing. */
+  private static final String[] PATH_FLAGS = {
+    "-Xfragment-sources=",
+    "-Xfragment-dependency=",
+    "-Xfragment-friend-dependency=",
+  };
+
+  private PathFixer() {}
+
+  /**
+   * Returns {@code arguments} with the paths of fragment flags absolutized, or the input itself
+   * when nothing changed.
+   */
+  public static List<String> fix(List<String> arguments) {
+    if (arguments == null || arguments.isEmpty()) {
+      return arguments;
+    }
+    List<String> fixed = null;
+    for (int i = 0; i < arguments.size(); i++) {
+      String rewritten = rewrite(arguments.get(i));
+      if (rewritten != null) {
+        if (fixed == null) {
+          fixed = new ArrayList<>(arguments);
+        }
+        fixed.set(i, rewritten);
+      }
+    }
+    return fixed == null ? arguments : fixed;
+  }
+
+  /**
+   * Returns the absolutized form of {@code "-Xfragment-sources=<fragment>:<path>"} and friends, or
+   * null when the argument is not such a flag or its path already is absolute.
+   */
+  private static String rewrite(String argument) {
+    for (String flag : PATH_FLAGS) {
+      if (!argument.startsWith(flag)) {
+        continue;
+      }
+      String value = argument.substring(flag.length());
+      // A Windows drive letter makes the path contain another ':', so split on the first one only.
+      int separator = value.indexOf(':');
+      if (separator < 0) {
+        return null;
+      }
+      String path = value.substring(separator + 1);
+      if (path.isEmpty()) {
+        return null;
+      }
+      String absolute = new File(path).getAbsolutePath();
+      if (absolute.equals(path)) {
+        return null;
+      }
+      return flag + value.substring(0, separator + 1) + absolute;
+    }
+    return null;
+  }
+}

