+package io.bazel.kotlin.agent;
+
+import java.lang.classfile.ClassFile;
+import java.lang.classfile.ClassModel;
+import java.lang.classfile.ClassTransform;
+import java.lang.classfile.CodeBuilder;
+import java.lang.classfile.CodeElement;
+import java.lang.classfile.CodeTransform;
+import java.lang.classfile.MethodModel;
+import java.lang.constant.ClassDesc;
+import java.lang.constant.MethodTypeDesc;
+import java.lang.instrument.ClassFileTransformer;
+import java.lang.instrument.Instrumentation;
+import java.security.ProtectionDomain;
+
+/**
+ * The {@code -javaagent} entry point that adapts the worker's pass-through flags to the Build Tools
+ * API compilation.
+ *
+ * <p>See {@link PathFixer} for the problem this solves. The agent is attached to the Kotlin worker
+ * JVM from {@code //src/main/kotlin:build}; it rewrites one getter of the worker's own
+ * {@code BtapiTaskExecutor.TaskCompilerConfiguration}, so it depends on rules_kotlin's contract but
+ * on none of the Build Tools API implementation classes.
+ */
+public final class PathFixAgent {
+  private PathFixAgent() {}
+
+  public static void premain(String agentArguments, Instrumentation instrumentation) {
+    // The target class is loaded lazily, long after premain, so no retransformation is needed; and
+    // the worker JVM does not offer retransformable transformers.
+    instrumentation.addTransformer(new FragmentPathTransformer(), false);
+  }
+
+  private static final class FragmentPathTransformer implements ClassFileTransformer {
+    // ClassFileTransformer hands class names in internal (slash-separated) form.
+    private static final String TARGET =
+        "io/bazel/kotlin/builder/tasks/jvm/btapi/BtapiTaskExecutor$TaskCompilerConfiguration";
+    private static final ClassDesc TARGET_DESC =
+        ClassDesc.of(
+            "io.bazel.kotlin.builder.tasks.jvm.btapi.BtapiTaskExecutor$TaskCompilerConfiguration");
+    private static final String GETTER = "getPassthroughArguments";
+    private static final String FIELD = "passthroughArguments";
+    private static final ClassDesc LIST = ClassDesc.of("java.util.List");
+    private static final ClassDesc FIXER = ClassDesc.of("io.bazel.kotlin.agent.PathFixer");
+    private static final MethodTypeDesc FIX = MethodTypeDesc.of(LIST, LIST);
+
+    @Override
+    public byte[] transform(
+        ClassLoader loader,
+        String className,
+        Class<?> classBeingRedefined,
+        ProtectionDomain protectionDomain,
+        byte[] classfileBuffer) {
+      if (!TARGET.equals(className)) {
+        return null;
+      }
+      ClassFile classFile =
+          ClassFile.of(
+              ClassFile.StackMapsOption.GENERATE_STACK_MAPS,
+              ClassFile.DeadCodeOption.PATCH_DEAD_CODE);
+      ClassModel model = classFile.parse(classfileBuffer);
+      return classFile.transformClass(
+          model,
+          ClassTransform.transformingMethodBodies(
+              FragmentPathTransformer::isPassthroughArguments,
+              CodeTransform.ofStateful(FragmentPathTransformer::fixedBody)));
+    }
+
+    private static boolean isPassthroughArguments(MethodModel method) {
+      return method.methodName().equalsString(GETTER);
+    }
+
+    /**
+     * Rebuilds the trivial getter as {@code return PathFixer.fix(this.passthroughArguments);}. The
+     * original body has no branches, and the Class-File API recomputes the stack map.
+     */
+    private static CodeTransform fixedBody() {
+      return new CodeTransform() {
+        private boolean emitted;
+
+        @Override
+        public void accept(CodeBuilder builder, CodeElement element) {
+          if (emitted) {
+            return;
+          }
+          emitted = true;
+          builder
+              .aload(0)
+              .getfield(TARGET_DESC, FIELD, LIST)
+              .invokestatic(FIXER, "fix", FIX)
+              .areturn();
+        }
+      };
+    }
+  }
+}

