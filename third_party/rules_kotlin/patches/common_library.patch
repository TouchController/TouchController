+load("@rules_java//java:defs.bzl", "java_binary", "java_library")
+
+# The Build Tools API compiles the operation's sources as absolute paths
+# (JvmCompilationOperationImpl.addSources uses File.absolutePath), while the
+# worker hands the compiler relative exec paths. A fragment's -Xfragment-sources
+# must equal the free-args entry verbatim, so the Build Tools API compilation
+# only works once those flags carry absolute paths too. This agent rewrites the
+# worker's pass-through flags at class definition time; it is inert on the
+# legacy invocation.
+java_library(
+    name = "agent_lib",
+    srcs = [
+        "PathFixAgent.java",
+        "PathFixer.java",
+    ],
+    visibility = ["//visibility:public"],
+)
+
+java_binary(
+    name = "agent",
+    create_executable = False,
+    deploy_manifest_lines = ["Premain-Class: io.bazel.kotlin.agent.PathFixAgent"],
+    main_class = "io.bazel.kotlin.agent.PathFixAgent",
+    visibility = ["//visibility:public"],
+    runtime_deps = [":agent_lib"],
+)

