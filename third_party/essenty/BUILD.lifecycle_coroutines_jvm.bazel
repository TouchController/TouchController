load("@rules_java//java:defs.bzl", "java_import")
load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_common_library", "kt_jvm_library")

kt_kotlinc_options(
    name = "kotlinc_opts_jvm_8",
    jvm_target = "1.8",
    x_jdk_release = "1.8",
    x_lambdas = "indy",
    warn = "off",
)

kt_jvm_library(
    name = "lifecycle_coroutines_jvm_lib",
    srcs = glob(["commonMain/**/*.kt"]),
    kotlinc_opts = ":kotlinc_opts_jvm_8",
    deps = [
        "@essenty_lifecycle//:lifecycle_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)

java_import(
    name = "lifecycle_coroutines_jvm",
    jars = ["lifecycle_coroutines_jvm_lib.jar"],
    srcjar = "lifecycle_coroutines_jvm_lib-sources.jar",
    visibility = ["//visibility:public"],
    deps = [
        "@essenty_lifecycle//:lifecycle_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)
