<idea-plugin>
    <id>fifthlight.textitem</id>
    <name>Text Folding</name>
    <version>0.0.2</version>
    <vendor>fifth_light</vendor>
    <idea-version since-build="263.7307" until-build="263.*"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <lang.foldingBuilder
                language="kotlin"
                implementationClass="top.fifthlight.intellij.textitem.TextItemFoldingBuilder"/>
    </extensions>
</idea-plugin>
