load("//game:game.bzl", "game_version")
load("//rule:remap_jar.bzl", "remap_jar")

game_version(
    name = "game",
    client = "@minecraft//1.8.9:client",
    client_assets = "@minecraft_assets//:assets_1.8.9",
    client_assets_version = "@minecraft_assets//:version_1.8.9",
    client_libraries = "@minecraft//1.8.9:client_libraries",
    client_native_manifest = "@minecraft//1.8.9:client_extract_libraries",
    intermediary = "@maven_fabric_1_8_9//:net_legacyfabric_intermediary_v2",
    server = "@minecraft//1.8.9:server",
    server_legacy = True,
    version = "1.8.9",
    visibility = ["//visibility:public"],
    yarn = "@maven_fabric_1_8_9//:net_legacyfabric_yarn_v2",
)

remap_jar(
    name = "fabric_api_named",
    classpath = [":game_client_intermediary"],
    from_namespace = "intermediary",
    inline_refmap = True,
    inputs = ["@maven_fabric_1_8_9//:net_legacyfabric_legacy_fabric_api_legacy_fabric_api"],
    mapping = ":game_merged_mapping",
    mixin = True,
    remap_transitive_deps = True,
    remove_jar_in_jar = True,
    tags = ["manual"],
    to_namespace = "named",
    visibility = ["//visibility:public"],
)
