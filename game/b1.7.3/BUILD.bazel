load("//game:game.bzl", "game_version")
load("//rule:remap_jar.bzl", "remap_jar")

package(default_visibility = ["//visibility:public"])

game_version(
    name = "game",
    client = "@minecraft//b1.7.3:client",
    client_assets = "@minecraft_assets//:assets_b1.7.3",
    client_assets_version = "@minecraft_assets//:version_b1.7.3",
    client_legacy = True,
    client_legacy_assets = True,
    client_libraries = "@minecraft//b1.7.3:client_libraries",
    client_native_manifest = "@minecraft//b1.7.3:client_extract_libraries",
    intermediary = "@maven_fabric_b1_7_3//:babric_intermediary_v2",
    split_source_namespace = True,
    version = "b1.7.3",
    yarn = "@maven_fabric_b1_7_3//:net_glasslauncher_biny_v2",
)

remap_jar(
    name = "modmenu_named",
    classpath = [":game_client_intermediary"],
    from_namespace = "intermediary",
    inputs = ["@maven_fabric_b1_7_3//:net_glasslauncher_mods_ModMenu"],
    mapping = ":game_merged_mapping",
    mixin = True,
    remove_jar_in_jar = True,
    tags = ["manual"],
    to_namespace = "named",
)
