load("//game:game.bzl", "game_version")
load("//rule:remap_jar.bzl", "remap_jar")

package(default_visibility = ["//visibility:public"])

game_version(
    name = "game",
    client = "@minecraft//1.21.1:client",
    client_assets = "@minecraft_assets//:assets_1.21.1",
    client_assets_version = "@minecraft_assets//:version_1.21.1",
    client_libraries = "@minecraft//1.21.1:client_libraries",
    client_mappings = "@minecraft//1.21.1:client_mappings",
    client_parchment = "@parchment_1_21_1//:json",
    intermediary = "@maven_fabric_1_21_1//:net_fabricmc_intermediary_v2",
    neoforge = "@neoforge_1_21_1//:neoforge",
    server = "@minecraft//1.21.1:server",
    version = "1.21.1",
    visibility = ["//visibility:public"],
)

alias(
    name = "kotlinforforge",
    actual = "@kotlinforforge_neoforge_1_21_1//:primary",
    tags = ["manual"],
)

alias(
    name = "sodium_neoforge",
    actual = "@sodium_neoforge_1_21_1//:primary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "iris_neoforge",
    actual = "@iris_neoforge_1_21_1//:primary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

remap_jar(
    name = "fabric_api_named",
    classpath = [":game_client_intermediary"],
    from_namespace = "intermediary",
    inline_refmap = True,
    inputs = ["@maven_fabric_1_21_1//:net_fabricmc_fabric_api_fabric_api"],
    mapping = ":game_merged_mapping",
    mixin = True,
    remap_transitive_deps = True,
    remove_jar_in_jar = True,
    tags = ["manual"],
    to_namespace = "named",
    visibility = ["//visibility:public"],
)

remap_jar(
    name = "modmenu_named",
    classpath = [
        ":game_client_intermediary",
        "@maven_fabric_1_21_1//:net_fabricmc_fabric_api_fabric_api",
