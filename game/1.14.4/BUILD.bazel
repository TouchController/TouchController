load("//game:game.bzl", "game_version")
load("//rule:remap_jar.bzl", "remap_jar")

package(default_visibility = ["//visibility:public"])

game_version(
    name = "game",
    client = "@minecraft//1.14.4:client",
    client_assets = "@minecraft_assets//:assets_1.14.4",
    client_assets_version = "@minecraft_assets//:version_1.14.4",
    client_libraries = "@minecraft//1.14.4:client_libraries",
    client_mappings = "@minecraft//1.14.4:client_mappings",
    forge = "@forge_1_14_4//:forge",
    intermediary = "@maven_fabric_1_14_4//:net_fabricmc_intermediary_v2",
    server = "@minecraft//1.14.4:server",
    server_legacy = True,
    version = "1.14.4",
)

remap_jar(
    name = "fabric_api_named",
    classpath = [":game_client_intermediary"],
    from_namespace = "intermediary",
    inline_refmap = True,
    inputs = ["@maven_fabric_1_14_4//:net_fabricmc_fabric_api_fabric_api"],
    mapping = ":game_merged_mapping",
    mixin = True,
    remap_transitive_deps = True,
    remove_jar_in_jar = True,
    tags = ["manual"],
    to_namespace = "named",
)

remap_jar(
    name = "modmenu_named",
    classpath = [
        ":game_client_intermediary",
        "@maven_fabric_1_14_4//:net_fabricmc_fabric_api_fabric_api",
    ],
    from_namespace = "intermediary",
    inputs = ["@maven_fabric_1_14_4//:io_github_prospector_modmenu"],
    mapping = ":game_merged_mapping",
    mixin = True,
    remove_jar_in_jar = True,
    tags = ["manual"],
    to_namespace = "named",
)

alias(
    name = "kotlinforforge",
    actual = "@kotlinforforge_forge_1_14_4//:primary",
    tags = ["manual"],
)
