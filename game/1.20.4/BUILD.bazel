load("//game:game.bzl", "game_version")
load("//rule:remap_jar.bzl", "remap_jar")

game_version(
    name = "game",
    client = "@minecraft//1.20.4:client",
    client_assets = "@minecraft_assets//:assets_1.20.4",
    client_assets_version = "@minecraft_assets//:version_1.20.4",
