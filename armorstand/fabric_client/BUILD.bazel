load("//armorstand:properties.bzl", "armorstand_version", "home_page", "issue_tracker", "license", "sources_page")
load("//rule:merge_library.bzl", "kt_merge_library", "merge_library_jar")
load("//rule/fabric:mod_json_jar.bzl", "fabric_mod_json_jar")

fabric_mod_json_jar(
    name = "fabric_mod_json",
    src = "resources/fabric.mod.json",
    substitutions = {
        "${version}": armorstand_version,
        "${license}": license,
        "${home_page}": home_page,
        "${sources_page}": sources_page,
        "${issue_tracker}": issue_tracker,
    },
)

kt_merge_library(
    name = "fabric_unmapped",
    srcs = glob(
        include = [
            "kotlin/**/*.kt",
            "java/**/*.java",
        ],
        allow_empty = True,
    ),
    actual = True,
    associates = [
        "//armorstand/main",
    ],
    merge_deps = [
        "//armorstand/client",
        "//armorstand/fabric_main:fabric_main_unmapped",
    ],
    resource_jars = [
        ":fabric_mod_json",
        "//armorstand/game:access_widener",
        "//armorstand/main:main_resources",
        "//armorstand/client:client_resources",
        "//armorstand/client/resources/assets/armorstand/lang",
    ],
    resource_strip_prefix = "armorstand/fabric/resources",
    resources = glob(
        include = ["resources/**"],
        allow_empty = True,
        exclude = ["resources/fabric.mod.json"],
    ),
    visibility = ["//armorstand:__subpackages__"],
    deps = [
        "//armorstand/game:remapped_client_access_widened_named",
        "//blazerod/model/model-formats",
        "//blazerod/render/api/event",
        "//game/1.21.8:fabric_api_named",
        "//game/1.21.8:game_client_libraries",
        "//game/1.21.8:iris_named",
        "//game/1.21.8:modmenu_named",
        "//game/1.21.8:placeholder_api_named",
        "//game/1.21.8:sodium_named",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
        "@maven_fabric_1_21_8//:net_fabricmc_fabric_loader",
    ],
)

merge_library_jar(
    name = "fabric_unmapped_merged",
    manifest_entries = {
        "Fabric-Loom-Mixin-Remap-Type": "static",
    },
    visibility = ["//armorstand:__subpackages__"],
    deps = [":fabric_unmapped"],
)
