load("//combine:properties.bzl", "combine_version")
load("//rule:class_version_test.bzl", "class_version_test")
load("//rule:merge_library.bzl", "merge_library_group", "merge_library_jar")
load("//rule:mod_info_jar.bzl", "mod_info_jar")
load("//touchcontroller:properties.bzl", "touchcontroller_authors", "touchcontroller_contributors", "touchcontroller_description", "touchcontroller_homepage", "touchcontroller_issue_tracker", "touchcontroller_license", "touchcontroller_source", "touchcontroller_version")

merge_library_group(
    name = "26.2",
    visibility = ["//touchcontroller:__subpackages__"],
    deps = [
        "//touchcontroller/versions/event/26.2",
        "//touchcontroller/versions/extension/26.2",
        "//touchcontroller/versions/gal/action/26.2",
        "//touchcontroller/versions/gal/chat/26.2",
        "//touchcontroller/versions/gal/creativetab/26.2",
        "//touchcontroller/versions/gal/entity/26.2",
        "//touchcontroller/versions/gal/feature/26.2",
        "//touchcontroller/versions/gal/gameconfig/26.2",
        "//touchcontroller/versions/gal/gamestate/26.2",
        "//touchcontroller/versions/gal/item/26.2",
        "//touchcontroller/versions/gal/itemlist/26.2",
        "//touchcontroller/versions/gal/key/26.2",
        "//touchcontroller/versions/gal/paint/26.2",
        "//touchcontroller/versions/gal/player/26.2",
        "//touchcontroller/versions/gal/view/26.2",
        "//touchcontroller/versions/gal/window/26.2",
        "//touchcontroller/versions/mixin/26.2",
    ],
)

merge_library_jar(
    name = "26.2_merged",
    aspect = True,
    aspect_class = "top.fifthlight.touchcontroller.v26_2.AspectProvider",
    aspect_impl_package_suffix = "v26_2",
    aspects = ["//touchcontroller/common:common_merged"],
    visibility = ["//touchcontroller:__subpackages__"],
    deps = [
        ":26.2",
        ":meta_jar",
    ],
)

class_version_test(
    name = "26.2_merged_class_version",
    class_major = 69,
    jars = [":26.2_merged"],
    tags = ["class_version"],
)

mod_info_jar(
    name = "meta_jar",
    fabric = "resources/fabric.mod.json",
    neoforge = "resources/neoforge.mods.toml",
    resources = {
        "//touchcontroller/resources/texture:icon": "assets/touchcontroller/textures/icon.png",
    },
    substitutions = {
        "${version}": touchcontroller_version,
        "${license}": touchcontroller_license,
        "${home_page}": touchcontroller_homepage,
        "${sources_page}": touchcontroller_source,
        "${issue_tracker}": touchcontroller_issue_tracker,
        "${description}": touchcontroller_description,
        "${combine_version}": combine_version,
        "${mod_authors}": ", ".join(touchcontroller_authors),
        "${mod_contributors}": ", ".join(touchcontroller_contributors),
        '"mod_authors_array"': json.encode(touchcontroller_authors),
        '"mod_contributors_array"': json.encode(touchcontroller_contributors),
    },
    visibility = ["//touchcontroller:__subpackages__"],
)
