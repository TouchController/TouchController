            "top.fifthlight.multijar.neov3.NeoV3Locator",
        ],
        "net.neoforged.neoforgespi.locating.IModFileReader": [
            "top.fifthlight.multijar.neoforge.ModFileReaderWrapper",
            "top.fifthlight.multijar.neov10.NeoV10ModReader",
            "top.fifthlight.multijar.neov3.NeoV3ModReader",
        ],
    },
    visibility = ["//visibility:public"],
    deps = [
        "//multijar/legacy",
        "//multijar/neov10",
        "//multijar/neov3",
    ],
