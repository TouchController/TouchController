    manifest_entries = {
        "Automatic-Module-Name": "multijar.loader",
    },
    service_wrappers = {
        "net.neoforged.neoforgespi.locating.IDependencyLocator": [
            "top.fifthlight.multijar.neoforge.DependencyLocatorWrapper",
