    module_name = "rules_android",
    patch_strip = 1,
    patches = [
        "//third_party/rules_android/patches:maven_pinning.patch",
        "//third_party/rules_android/patches:lower_min_sdk_floor.patch",
    ],
    version = "0.7.3",
)

