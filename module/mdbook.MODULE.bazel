"MODULE.bazel mdbook part"

mdbook_deps = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
mdbook_deps.spec(
    artifact = "bin",
    package = "mdbook",
    version = "=0.5.4",
)
mdbook_deps.annotation(
    crate = "mdbook",
    gen_all_binaries = True,
)
mdbook_deps.from_specs(
    name = "mdbook_deps",
    host_tools = "@rust_host_tools_nightly",
    cargo_lockfile = "//:Cargo.mdbook.lock",
    lockfile = "//:cargo-bazel-mdbook-lock.json",
)
use_repo(mdbook_deps, "mdbook_deps")

register_toolchains("//toolchain:mdbook_toolchain")
